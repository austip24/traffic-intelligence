# Copy to .env.local. Never commit real values.
# With Vercel, `vercel env pull .env.local` fills the database variables.

# Postgres with PostGIS (Vercel Postgres / Neon). The app uses the pooled URL;
# migrations and the ETL prefer the direct (unpooled) URL when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional MapLibre style URLs for the basemap. When unset, the app uses
# CARTO Positron (light) and Dark Matter (dark), which require
# "© OpenStreetMap contributors © CARTO" attribution and have usage limits.
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=
